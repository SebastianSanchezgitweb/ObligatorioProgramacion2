@page "{idEvento:int}"
@model EditarEventoSocialModel
@using Dominio
@{
}

<div class="row d-flex justify-content-center">
    <form class="col-6" method="post">

        <input type="hidden" asp-for="EventoSocialEditar.idEvento" />
        <input type="hidden" asp-for="EventoSocialEditar.Cliente.IdCliente" />

        <div class="mb-3">
            <label asp-for="EventoSocialEditar.Nombre" class="form-label">Nombre</label>
            <input type="text" class="form-control" asp-for="EventoSocialEditar.Nombre" />
        </div>

        <div class="mb-3">
            <label asp-for="EventoSocialEditar.TipoColaboracion" class="form-label">Tipo de colaboración</label>
            <input type="text" class="form-control" asp-for="EventoSocialEditar.TipoColaboracion" />
        </div>

        <div class="form-check mb-3">
            <input asp-for="EventoSocialEditar.IncluyeCatering" class="form-check-input" />
            <label class="form-check-label" asp-for="EventoSocialEditar.IncluyeCatering">Incluye catering</label>
        </div>

        <div class="mb-3">
            <label asp-for="EventoSocialEditar.Ubicacion" class="form-label">Ubicación</label>
            <input type="text" class="form-control" asp-for="EventoSocialEditar.Ubicacion" />
        </div>

        <div class="mb-3">
            <label asp-for="EventoSocialEditar.CantidadAsistentes" class="form-label">Cantidad asistentes</label>
            <input type="number" class="form-control" asp-for="EventoSocialEditar.CantidadAsistentes" />
        </div>

        <div class="mb-3">
            <label asp-for="EventoSocialEditar.FechaRealizacion" class="form-label">Fecha Realización</label>
            <input type="datetime-local" class="form-control" asp-for="EventoSocialEditar.FechaRealizacion" />
        </div>

        <div class="mb-3">
            <label asp-for="EventoSocialEditar.FechaFinalizacion" class="form-label">Fecha Finalización</label>
            <input type="datetime-local" class="form-control" asp-for="EventoSocialEditar.FechaFinalizacion" />
        </div>

        <div class="mb-3">
            <label asp-for="EventoSocialEditar.Estado" class="form-label">Estado</label>
            <select class="form-control" asp-for="EventoSocialEditar.Estado" asp-items='@Html.GetEnumSelectList<EstadoEvento>()'>
                <option value="">-- Seleccionar --</option>
            </select>
        </div>

        <button type="submit" class="btn btn-primary">Modificar</button>
    </form>
</div>